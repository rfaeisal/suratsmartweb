generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// MASTER DATA — PEGAWAI & UNIT KERJA
// ============================================================

model Employee {
  id                 String         @id @default(cuid())
  legacyId           String         @unique
  nip                String         @unique
  fullName           String
  employeeType       EmployeeType
  unitId             String?
  unit               WorkUnit?      @relation(fields: [unitId], references: [id])
  positionTitle      String?
  positionId         String?
  position           Position?      @relation(fields: [positionId], references: [id])
  directSupervisorId String?
  room               String?
  avatarUrl          String?
  isActive           Boolean        @default(true)
  source             EmployeeSource @default(LEGACY)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user              AppUser?
  leaveRequests     LeaveRequest[] @relation("Requester")
  delegatedRequests LeaveRequest[] @relation("Delegate")
  approvalSteps     ApprovalStep[]
  leaveQuotas       LeaveQuota[]
  unitAsKepala      WorkUnit[]     @relation("KepalaRuangan")
  unitAsAdmin       WorkUnit[]     @relation("AdminUnit")
  attendances       Attendance[]
  rosters           Roster[]
  overtimes         Overtime[]
  alphaRecords      AlphaRecord[]
  swapRequests      ShiftSwapRequest[] @relation("SwapRequester")
  swapTargets       ShiftSwapRequest[] @relation("SwapTarget")
}

enum EmployeeType {
  PNS
  PPPK
  PPPK_PARUH_WAKTU
  BLUD
}

enum EmployeeSource {
  MOCK
  LEGACY
  MANUAL
}

model Position {
  id        String     @id @default(cuid())
  name      String     @unique
  level     Int
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  employees Employee[]
}

model WorkUnit {
  id              String     @id @default(cuid())
  name            String
  parentId        String?
  parent          WorkUnit?  @relation("UnitHierarchy", fields: [parentId], references: [id])
  children        WorkUnit[] @relation("UnitHierarchy")
  kepalaRuanganId String?
  kepalaRuangan   Employee?  @relation("KepalaRuangan", fields: [kepalaRuanganId], references: [id])
  adminUnitId     String?
  adminUnit       Employee?  @relation("AdminUnit", fields: [adminUnitId], references: [id])
  employees       Employee[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  managedBy     AppUser[]      @relation("ManagedUnit")
  rooms         Room[]
  shiftUnits    ShiftUnit[]
  rosterPeriods RosterPeriod[]
  rosters       Roster[]
  attendances   Attendance[]
  overtimes     Overtime[]
  shiftSwaps    ShiftSwapRequest[]
}

// ============================================================
// JENIS CUTI & KUOTA
// ============================================================

model LeaveType {
  id                 String         @id @default(cuid())
  code               String         @unique
  name               String
  applicableTo       EmployeeType[]
  requiresAttachment Boolean        @default(false)
  defaultQuotaDays   Int?
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  quotas        LeaveQuota[]
  leaveRequests LeaveRequest[]
}

model LeaveQuota {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  totalDays   Int
  usedDays    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
}

// ============================================================
// PENGAJUAN CUTI
// ============================================================

model LeaveRequest {
  id                         String                     @id @default(cuid())
  requestNumber              String                     @unique
  requesterId                String
  requester                  Employee                   @relation("Requester", fields: [requesterId], references: [id])
  leaveTypeId                String
  leaveType                  LeaveType                  @relation(fields: [leaveTypeId], references: [id])
  startDate                  DateTime
  endDate                    DateTime
  totalDays                  Int
  reason                     String
  addressDuringLeave         String?
  emergencyPhone             String?
  delegateId                 String?
  delegate                   Employee?                  @relation("Delegate", fields: [delegateId], references: [id])
  status                     LeaveRequestStatus         @default(SUBMITTED)
  currentStepOrder           Int                        @default(0)
  delegateConfirmationStatus DelegateConfirmationStatus @default(PENDING)
  delegateDecidedAt          DateTime?
  delegateNote               String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  attachments     LeaveAttachment[]
  approvalSteps   ApprovalStep[]
  skDocument      SkDocument?
  integrationLogs IntegrationLog[]
}

enum LeaveRequestStatus {
  SUBMITTED
  DELEGATE_DECLINED
  PENDING_KEPALA_RUANGAN
  PENDING_ADMIN_REVIEW
  IN_APPROVAL
  RETURNED
  REJECTED
  APPROVED
  SENT_TO_LEGACY
  SEND_FAILED
}

enum DelegateConfirmationStatus {
  PENDING
  CONFIRMED
  DECLINED
}

model LeaveAttachment {
  id             String       @id @default(cuid())
  leaveRequestId String
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id])
  fileName       String
  filePath       String
  uploadedAt     DateTime     @default(now())
}

// ============================================================
// ALUR APPROVAL (dinamis, ditetapkan admin per pengajuan)
// ============================================================

model ApprovalStep {
  id             String             @id @default(cuid())
  leaveRequestId String
  leaveRequest   LeaveRequest       @relation(fields: [leaveRequestId], references: [id])
  stepOrder      Int
  approverId     String
  approver       Employee           @relation(fields: [approverId], references: [id])
  roleLabel      String
  status         ApprovalStepStatus @default(PENDING)
  note           String?
  decidedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([leaveRequestId, stepOrder])
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

// ============================================================
// SK CUTI & INTEGRASI LEGACY
// ============================================================

model SkDocument {
  id             String       @id @default(cuid())
  leaveRequestId String       @unique
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id])
  skNumber       String       @unique
  filePath       String
  generatedAt    DateTime     @default(now())
}

model IntegrationLog {
  id              String       @id @default(cuid())
  leaveRequestId  String
  leaveRequest    LeaveRequest @relation(fields: [leaveRequestId], references: [id])
  direction       String       // "PUSH_LEAVE_TO_LEGACY"
  status          String       // PENDING | SUCCESS | FAILED
  requestPayload  Json
  responsePayload Json?
  attemptCount    Int          @default(0)
  lastAttemptAt   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// ============================================================
// USER, SESI LOGIN & NOTIFIKASI
// ============================================================

model AppUser {
  id                String    @id @default(cuid())
  employeeId        String    @unique
  employee          Employee  @relation(fields: [employeeId], references: [id])
  username          String?   @unique
  roles             AppRole[]
  managedWorkUnitId String?
  managedWorkUnit   WorkUnit? @relation("ManagedUnit", fields: [managedWorkUnitId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  fcmTokens FcmToken[]
  sessions  UserSession[]
}

enum AppRole {
  PEGAWAI
  APPROVER
  KEPALA_UNIT
  ADMIN_UNIT
  ADMIN_KEPEGAWAIAN
  SUPERADMIN
}

model UserSession {
  id               String        @id @default(cuid())
  userId           String
  user             AppUser       @relation(fields: [userId], references: [id])
  deviceId         String
  deviceLabel      String?
  refreshTokenHash String        @unique
  status           SessionStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
  lastActiveAt     DateTime      @default(now())
  revokedAt        DateTime?
  revokedBy        String?       // "SELF" | "ADMIN" | AppUser.id admin yg mencabut
}

enum SessionStatus {
  ACTIVE
  REVOKED
}

model FcmToken {
  id        String   @id @default(cuid())
  userId    String
  user      AppUser  @relation(fields: [userId], references: [id])
  deviceId  String?  @unique
  token     String
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
}

// ============================================================
// PENGATURAN SISTEM
// ============================================================

model AppSetting {
  key       String   @id
  value     String
  label     String   @default("")
  updatedAt DateTime @updatedAt
}

// ============================================================
// MODUL ABSENSI — RUANGAN & PERANGKAT ESP32
// ============================================================

model Room {
  id         String   @id @default(cuid())
  nama       String
  kode       String   @unique
  workUnitId String
  workUnit   WorkUnit @relation(fields: [workUnitId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  devices     Device[]
  attendances Attendance[]
}

model Device {
  id           String       @id @default(cuid())
  nama         String?
  deviceId     String       @unique
  secretHash   String       // AES-256-GCM encrypted; NEVER log
  ibeaconUuid  String
  ibeaconMajor Int
  ibeaconMinor Int
  roomId       String?
  room         Room?        @relation(fields: [roomId], references: [id])
  status       DeviceStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  attendances Attendance[]
  qrUsages    QrUsage[]
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
}

model QrUsage {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id])
  employeeId String
  counter    BigInt
  usedAt     DateTime @default(now())

  @@unique([employeeId, deviceId, counter])
}

// ============================================================
// MODUL ABSENSI — SHIFT & ROSTER
// ============================================================

model Shift {
  id              String    @id @default(cuid())
  nama            String
  startTime       String    // "HH:MM"
  endTime         String    // "HH:MM"
  crossesMidnight Boolean   @default(false)
  type            ShiftType @default(ROTASI)
  workDays        Int[]     @default([])
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shiftUnits ShiftUnit[]
  rosters    Roster[]
}

enum ShiftType {
  ROTASI
  TETAP
}

model ShiftUnit {
  id         String   @id @default(cuid())
  shiftId    String
  shift      Shift    @relation(fields: [shiftId], references: [id])
  workUnitId String
  workUnit   WorkUnit @relation(fields: [workUnitId], references: [id])

  @@unique([shiftId, workUnitId])
}

model PublicHoliday {
  id        String            @id @default(cuid())
  date      DateTime          @unique @db.Date
  nama      String
  jenis     PublicHolidayType @default(NASIONAL)
  createdAt DateTime          @default(now())
}

enum PublicHolidayType {
  NASIONAL
  CUTI_BERSAMA
}

model RosterPeriod {
  id          String             @id @default(cuid())
  workUnitId  String
  workUnit    WorkUnit           @relation(fields: [workUnitId], references: [id])
  year        Int
  month       Int
  status      RosterPeriodStatus @default(DRAFT)
  publishedAt DateTime?
  publishedBy String?            // AppUser.id
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  rosters Roster[]

  @@unique([workUnitId, year, month])
}

enum RosterPeriodStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
}

model Roster {
  id           String       @id @default(cuid())
  employeeId   String
  employee     Employee     @relation(fields: [employeeId], references: [id])
  workUnitId   String
  workUnit     WorkUnit     @relation(fields: [workUnitId], references: [id])
  periodId     String
  period       RosterPeriod @relation(fields: [periodId], references: [id])
  shiftId      String
  shift        Shift        @relation(fields: [shiftId], references: [id])
  tanggalKerja DateTime     @db.Date
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  alphaRecord     AlphaRecord?
  swapAsRequester ShiftSwapRequest[] @relation("SwapRequesterRoster")
  swapAsTarget    ShiftSwapRequest[] @relation("SwapTargetRoster")

  @@unique([employeeId, tanggalKerja])
}

// ============================================================
// MODUL ABSENSI — CATATAN KEHADIRAN
// ============================================================

model Attendance {
  id             String           @id @default(cuid())
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id])
  eventType      AttendanceEvent
  recordedAt     DateTime         @default(now())
  tanggalKerja   DateTime         @db.Date
  deviceId       String
  device         Device           @relation(fields: [deviceId], references: [id])
  roomId         String?
  room           Room?            @relation(fields: [roomId], references: [id])
  workUnitId     String?
  workUnit       WorkUnit?        @relation(fields: [workUnitId], references: [id])
  counter        BigInt
  beaconDetected Boolean
  status         AttendanceStatus @default(VALID)
  telat          Boolean          @default(false)
  flags          Json             @default("[]")
  createdAt      DateTime         @default(now())

  @@unique([employeeId, deviceId, counter])
}

enum AttendanceEvent {
  MASUK
  PULANG
  LEMBUR_MASUK
  LEMBUR_PULANG
}

enum AttendanceStatus {
  VALID
  ALPHA
}

model AlphaRecord {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  rosterId     String   @unique
  roster       Roster   @relation(fields: [rosterId], references: [id])
  tanggalKerja DateTime @db.Date
  markedAt     DateTime @default(now())

  @@unique([employeeId, tanggalKerja])
}

// ============================================================
// MODUL ABSENSI — LEMBUR & TUKAR SHIFT
// ============================================================

model Overtime {
  id             String         @id @default(cuid())
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id])
  workUnitId     String
  workUnit       WorkUnit       @relation(fields: [workUnitId], references: [id])
  tanggalKerja   DateTime       @db.Date
  status         OvertimeStatus @default(DIAJUKAN)
  approvedUnitBy String?
  approvedUnitAt DateTime?
  approvedHrBy   String?
  approvedHrAt   DateTime?
  rejectedBy     String?
  rejectedAt     DateTime?
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

enum OvertimeStatus {
  DIAJUKAN
  DISETUJUI_UNIT
  SAH
  DITOLAK
}

model ShiftSwapRequest {
  id                String     @id @default(cuid())
  requesterId       String
  requester         Employee   @relation("SwapRequester", fields: [requesterId], references: [id])
  targetId          String
  target            Employee   @relation("SwapTarget", fields: [targetId], references: [id])
  requesterRosterId String
  requesterRoster   Roster     @relation("SwapRequesterRoster", fields: [requesterRosterId], references: [id])
  targetRosterId    String
  targetRoster      Roster     @relation("SwapTargetRoster", fields: [targetRosterId], references: [id])
  workUnitId        String
  workUnit          WorkUnit   @relation(fields: [workUnitId], references: [id])
  status            SwapStatus @default(MENUNGGU_TARGET)
  alasan            String?
  rejectedBy        String?    // Employee.id
  approvedByUnitAt  DateTime?
  approvedByUnitId  String?    // AppUser.id
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

enum SwapStatus {
  MENUNGGU_TARGET
  MENUNGGU_KEPALA
  DISETUJUI
  DITOLAK
}
